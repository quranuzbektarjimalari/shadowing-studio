{
  "name": "shadowing-youtube-studio",
  "productName": "Shadowing Youtube Studio",
  "version": "3.0.0",
  "description": "Shadowing Studio — YouTube video bilan shadowing mashq dasturi (MP3 yozuv)",
  "main": "main.js",
  "author": "Shadowing Studio",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "shadowingyoutubestudio.app",
    "productName": "Shadowing Youtube Studio",
    "copyright": "Shadowing Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "serve.js",
      "appserver.js",
      "encoder.js",
      "preload.js",
      "package.json",
      "app/**/*",
      "build/icon.png",
      "node_modules/ffmpeg-static/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shadowing Youtube Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Shadowing-Youtube-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Shadowing-Youtube-Studio-Portable-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}
